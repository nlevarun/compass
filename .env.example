# Compass Environment Configuration
# Copy this file to .env and fill in your values

# Slack OAuth Configuration
# Get these from https://api.slack.com/apps
SLACK_CLIENT_ID=your_slack_client_id_here
SLACK_CLIENT_SECRET=your_slack_client_secret_here
SLACK_REDIRECT_URI=http://localhost:8000/api/auth/slack/callback

# For production, use your production URL:
# SLACK_REDIRECT_URI=https://your-domain.com/api/auth/slack/callback

# Linear OAuth Configuration
# Get these from https://linear.app/settings/api/applications
LINEAR_CLIENT_ID=your_linear_client_id_here
LINEAR_CLIENT_SECRET=your_linear_client_secret_here
LINEAR_REDIRECT_URI=http://localhost:8000/api/auth/linear/callback

# For production, use your production URL:
# LINEAR_REDIRECT_URI=https://your-domain.com/api/auth/linear/callback

# Database (optional, defaults to SQLite)
# DATABASE_URL=sqlite:///compass.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost:5432/compass

# API Configuration (optional)
# API_KEY=your_api_key_for_protected_endpoints
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Other integrations (optional)
# GITHUB_TOKEN=your_github_personal_access_token
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=your-email@example.com
# JIRA_API_TOKEN=your_jira_api_token
